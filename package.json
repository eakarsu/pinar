{
  "name": "pinar-static-reference",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.node.json --pretty false",
    "test": "node --test tests/boundary.test.mjs",
    "test:runtime": "node --test tests/runtime.test.mjs",
    "validate:boundary": "node scripts/validate-boundary.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "verify": "npm run validate:boundary && npm run typecheck && npm run lint && npm test && npm run audit:prod",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.64.0",
    "vite": "8.1.5"
  }
}
